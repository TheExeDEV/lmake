<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lmake</AssemblyName>
    <RootNamespace>lmake</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8981</NoWarn>

    <Description>Build tool for Luau with a built-in GPP-compatible preprocessor and .luaurc require conversion</Description>
    <Authors>TheExeDEV</Authors>
    <RepositoryUrl>https://github.com/TheExeDEV/lmake</RepositoryUrl>
    <PackageProjectUrl>https://github.com/TheExeDEV/lmake</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 TheExeDEV</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LMake.Tests" />
  </ItemGroup>

</Project>
